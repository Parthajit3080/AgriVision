# Copy to .env for local development. Never commit real secrets.
APP_ENV=development
AGRIVISION_SECRET=
AGRIVISION_DB_PATH=./data/agrivision.sqlite3
AGRIVISION_COOKIE_SECURE=false
AGRIVISION_COOKIE_SAMESITE=lax
FRONTEND_ORIGIN=http://localhost:3000
APP_PUBLIC_URL=http://localhost:3000
NEXT_PUBLIC_AGRIVISION_API=http://localhost:8000

# Optional SMTP for account recovery. Without SMTP, reset links are returned only in development.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=AgriVision <no-reply@example.com>
