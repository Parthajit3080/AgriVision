{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "pnpm build",
  "functions": {
    "app.py": {
      "includeFiles": "{out/**,model/**,backend/migrations/**}"
    }
  },
  "routes": [
    { "src": "/api/(?<api>.*)", "dest": "/app.py?_asgi_path=/api/$api" },
    { "handle": "filesystem" },
    { "src": "/(?<path>.*)", "dest": "/app.py?_asgi_path=/$path" }
  ]
}
